    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^24.19.2",
    "fake-indexeddb": "^6.2.8",
    "svelte": "^5.59.1",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.1.1"
  }
